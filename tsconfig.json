// Node runs the sources and tests directly by stripping out the types, and stops with an
// error on TypeScript it can't strip, such as an enum or a parameter property, which
// `erasableSyntaxOnly` makes tsc flag first. Node won't strip a file under node_modules, so
// tsconfig.build.json compiles src/ into dist/ for the copy npm installs.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
